{
  "name": "Hen'i-tai 変異体",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "castwide.solargraph",
        "misogi.ruby-rubocop",
        "hridoy.rails-snippets",
        "KoichiSasada.vscode-rdbg"
      ],
      "settings": {
        "ruby.useBundler": true,
        "ruby.lint": { "rubocop": true },
        "ruby.format": "rubocop",
        "[ruby]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": null
        }
      }
    }
  },
  "postCreateCommand": "bundle install && mkdir -p ~/.claude && rtk init -g --codex && rtk init -g --auto-patch && configure-pi-models",
  "remoteEnv": {
    "BUNDLE_PATH": "/usr/local/bundle",
    "OPENAI_BASE_URL": "http://host.docker.internal:8000/v1",
    "OPENAI_API_BASE": "http://host.docker.internal:8000/v1",
    "OPENAI_API_KEY": "llmapi",
    "PI_OPENAI_BASE_URL": "http://host.docker.internal:8000/v1",
    "PI_OPENAI_API_KEY": "llmapi"
  },
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "mounts": [
    "source=henitai-bundle,target=/usr/local/bundle,type=volume",
    "source=${localWorkspaceFolder}/../henitai-worktrees,target=/workspaces/worktrees,type=bind",
    "source=${localWorkspaceFolder}/.henitai-pi-agent,target=/home/vscode/.pi,type=bind"
  ],
  "forwardPorts": [],
  "remoteUser": "vscode"
}

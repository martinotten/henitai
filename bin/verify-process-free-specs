#!/usr/bin/env ruby
# frozen_string_literal: true

require "rspec/core"
ENV["HENITAI_PROCESS_GUARD"] = "1"
require_relative "../spec/support/process_guard"

exclude_pattern = "spec/{fixtures/**/*_spec.rb,**/*_process_spec.rb}"
arguments = [
  "--pattern", "spec/**/*_spec.rb",
  "--exclude-pattern", exclude_pattern
]

exit RSpec::Core::Runner.run(arguments)
